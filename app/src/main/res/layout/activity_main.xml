<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"
        android:text="접근성 권한 상태 확인 중..." />

    <Button
        android:id="@+id/openAccessibilitySettingsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="접근성 설정 열기" />

    <TextView
        android:id="@+id/lockStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:layout_marginTop="24dp"
        android:text="보호 상태 확인 중..." />

    <Button
        android:id="@+id/activateAdminButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="기기 관리자 활성화 (삭제 방지)" />

    <EditText
        android:id="@+id/unlockPasswordInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="관리자 비밀번호"
        android:inputType="textPassword|textNoSuggestions" />

    <Button
        android:id="@+id/unlockButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="관리자 비밀번호로 해제" />

    <Button
        android:id="@+id/relockButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="다시 잠그기" />

    <Switch
        android:id="@+id/blockInstagramSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="인스타그램 릴스 차단" />

    <Switch
        android:id="@+id/igExploreHideSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="인스타 탐색 탭 피드 가리기" />

    <Switch
        android:id="@+id/blockYoutubeSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="유튜브 Shorts 차단" />

    <Switch
        android:id="@+id/ytHomeHideSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="유튜브 홈 피드 숨기기 (구독 화면으로 이동)" />

    <Switch
        android:id="@+id/debugLogSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="디버그 로그 모드 (릴스/Shorts 화면 요소 이름을 logcat에 출력)" />

</LinearLayout>
</ScrollView>
